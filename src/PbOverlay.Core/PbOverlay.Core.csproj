<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinRT interop for Windows.Graphics.Capture needs a Windows-versioned TFM. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>PbOverlay.Core</RootNamespace>
    <AssemblyName>PbOverlay.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <!-- Vortice.Windows is the repo name, not a package id; DXGI + Direct3D come in via this one. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.5.0" />
  </ItemGroup>

</Project>
