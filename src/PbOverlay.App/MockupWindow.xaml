<Window x:Class="PbOverlay.App.MockupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PbOverlay — layout mockup"
        Width="1080" Height="680"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource Bg}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" CornerRadius="12">
            <DockPanel Margin="0,12">
                <!-- status dot: green = attached, capture fps in tooltip -->
                <Ellipse DockPanel.Dock="Bottom" Width="10" Height="10"
                         Fill="{StaticResource Accent}" Margin="0,12,0,4"
                         HorizontalAlignment="Center"
                         ToolTip="Attached: Point Blank — capture 141 fps"/>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Content="&#xE77B;" ToolTip="Profile / status"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="&#xE78B;" ToolTip="Overlay" IsChecked="True"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="&#xE799;" ToolTip="Calibration"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="&#xE713;" ToolTip="Classifier tuning"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="&#xE7FC;" ToolTip="Game config reader"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="&#xE7C3;" ToolTip="Logs"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Feature toggles ================= -->
        <ScrollViewer Grid.Column="1" Margin="12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Overlay" Style="{StaticResource PageTitle}"/>

                <!-- Row template: [icon] [name] .......... [toggle] [hotkey] -->

                <Border Style="{StaticResource FeatureRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Performance strip"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="2" Style="{StaticResource PillToggle}" IsChecked="True"/>
                        <Button Grid.Column="3" Style="{StaticResource HotkeyBadge}" Content="F11"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FeatureRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Alive players count"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="2" Style="{StaticResource PillToggle}" IsChecked="True"/>
                        <Button Grid.Column="3" Style="{StaticResource HotkeyBadge}" Content="F9"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FeatureRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xEA3A;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Per-slot dots"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="2" Style="{StaticResource PillToggle}"/>
                        <Button Grid.Column="3" Style="{StaticResource HotkeyBadge}" Content="—"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FeatureRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Round stats panel"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Background="Transparent" BorderBrush="{StaticResource ExperimentalBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="EXPERIMENTAL" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource ExperimentalBrush}"/>
                        </Border>
                        <ToggleButton Grid.Column="3" Style="{StaticResource PillToggle}"/>
                        <Button Grid.Column="4" Style="{StaticResource HotkeyBadge}" Content="—"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FeatureRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Session records"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Background="Transparent" BorderBrush="{StaticResource ExperimentalBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="EXPERIMENTAL" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource ExperimentalBrush}"/>
                        </Border>
                        <ToggleButton Grid.Column="3" Style="{StaticResource PillToggle}"/>
                        <Button Grid.Column="4" Style="{StaticResource HotkeyBadge}" Content="—"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FeatureRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="FPS counter only"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="2" Style="{StaticResource PillToggle}"/>
                        <Button Grid.Column="3" Style="{StaticResource HotkeyBadge}" Content="—"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FeatureRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Ping display"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="2" Style="{StaticResource PillToggle}"/>
                        <Button Grid.Column="3" Style="{StaticResource HotkeyBadge}" Content="—"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FeatureRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Lock overlay positions"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="2" Style="{StaticResource PillToggle}" IsChecked="True"/>
                        <Button Grid.Column="3" Style="{StaticResource HotkeyBadge}" Content="F6"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Side cards ================= -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="Actions" Style="{StaticResource PageTitle}"/>

            <Button Style="{StaticResource ActionCard}">
                <StackPanel>
                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="20"
                               Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
                    <TextBlock Text="Attach to game" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Point Blank — attached" FontSize="11"
                               Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ActionCard}">
                <StackPanel>
                    <TextBlock Text="&#xE799;" FontFamily="{StaticResource IconFont}" FontSize="20"
                               Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
                    <TextBlock Text="Calibrate ROI" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Last calibrated today 14:02" FontSize="11"
                               Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ActionCard}">
                <StackPanel>
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="20"
                               Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
                    <TextBlock Text="Export / import config" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Share a working profile as JSON" FontSize="11"
                               Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
