<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Palette — change AccentColor to rebrand ============ -->
    <Color x:Key="AccentColor">#2DD4BF</Color>

    <SolidColorBrush x:Key="Accent"       Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDim"    Color="#1A6E63"/>
    <SolidColorBrush x:Key="Bg"           Color="#121417"/>
    <SolidColorBrush x:Key="Surface"      Color="#1A1D21"/>
    <SolidColorBrush x:Key="SurfaceAlt"   Color="#22262C"/>
    <SolidColorBrush x:Key="RowHover"     Color="#2A2F36"/>
    <SolidColorBrush x:Key="Stroke"       Color="#33393F"/>
    <SolidColorBrush x:Key="TextPrimary"  Color="#E8EAED"/>
    <SolidColorBrush x:Key="TextMuted"    Color="#8A9199"/>
    <SolidColorBrush x:Key="ToggleOffTrack" Color="#3A4048"/>
    <SolidColorBrush x:Key="ExperimentalBrush" Color="#D9A036"/>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ============ Section / page title ============ -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Margin" Value="4,0,0,12"/>
    </Style>

    <!-- ============ Sidebar nav item (icon-only radio) ============ -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Width="44" Height="44" CornerRadius="10"
                            Background="Transparent" Margin="0,4">
                        <Grid>
                            <Rectangle x:Name="Pip" Width="3" Height="20" RadiusX="1.5" RadiusY="1.5"
                                       HorizontalAlignment="Left" Fill="{StaticResource Accent}"
                                       Visibility="Collapsed"/>
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="{StaticResource IconFont}" FontSize="18"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                            <Setter TargetName="Pip" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Pill toggle switch ============ -->
    <Style x:Key="PillToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" Width="42" Height="22" CornerRadius="11"
                            Background="{StaticResource ToggleOffTrack}">
                        <Ellipse x:Name="Dot" Width="16" Height="16" Fill="#C7CCD1"
                                 HorizontalAlignment="Left" Margin="3,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Dot" Property="Fill" Value="#0E1113"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Hotkey badge (click to rebind) ============ -->
    <Style x:Key="HotkeyBadge" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" MinWidth="44" Height="26" CornerRadius="6"
                            Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            Padding="8,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Feature row container ============ -->
    <Style x:Key="FeatureRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RowHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Side action card ============ -->
    <Style x:Key="ActionCard" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource Surface}" CornerRadius="12"
                            BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            Padding="16" Margin="0,0,0,12">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
