<Window x:Class="PbOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:PbOverlay.App.Tabs"
        Title="PbOverlay"
        Width="1100" Height="720">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="8">
            <Button x:Name="ShowHideButton" Content="Show/Hide Overlay" Padding="8,4" Click="ShowHideButton_Click"/>
            <Button x:Name="SaveConfigButton" Content="Save Config" Padding="8,4" Margin="8,0,0,0" Click="SaveConfigButton_Click"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="8,0,8,8">
            <TabItem Header="Capture Source">
                <tabs:CaptureSourceTab/>
            </TabItem>
            <TabItem Header="ROI Calibration">
                <tabs:RoiCalibrationTab/>
            </TabItem>
            <TabItem Header="Classifier Tuning">
                <tabs:ClassifierTuningTab/>
            </TabItem>
            <TabItem Header="Overlay Appearance">
                <tabs:OverlayAppearanceTab/>
            </TabItem>
            <TabItem Header="Game Config">
                <tabs:GameConfigTab/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
