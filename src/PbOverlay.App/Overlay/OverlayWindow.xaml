<Window x:Class="PbOverlay.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        Title="PbOverlay">
    <!-- Layered + click-through composites over borderless-windowed and windowed
         modes. Exclusive fullscreen may bypass DWM composition and hide the
         overlay entirely — recommend borderless windowed in the README. -->
    <Grid>
        <Viewbox Stretch="Uniform">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                <TextBlock x:Name="CountText"
                           Text="0 v 0"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           FontSize="32"
                           Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect x:Name="CountOutline"
                                          ShadowDepth="0"
                                          BlurRadius="0"
                                          Color="Black"
                                          Opacity="1"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="FpsText"
                           Text="n/a"
                           FontFamily="Consolas"
                           FontSize="16"
                           Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect x:Name="FpsOutline"
                                          ShadowDepth="0"
                                          BlurRadius="0"
                                          Color="Black"
                                          Opacity="1"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Viewbox>
    </Grid>
</Window>
