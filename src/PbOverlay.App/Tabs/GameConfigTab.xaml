<UserControl x:Class="PbOverlay.App.Tabs.GameConfigTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Browse..." Padding="8,4" Margin="6,0,0,0" Click="BrowseButton_Click"/>
            <Button Grid.Column="2" Content="Read" Padding="8,4" Margin="6,0,0,0" Click="ReadButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock><Run Text="File path: "/><Run x:Name="FilePathRun"/></TextBlock>
            <TextBlock><Run Text="Last modified (UTC): "/><Run x:Name="LastModifiedRun"/></TextBlock>
            <TextBlock><Run Text="Detected format: "/><Run x:Name="DetectedFormatRun"/></TextBlock>
        </StackPanel>

        <TextBlock Grid.Row="2" Margin="0,8,0,4" Text="First 256 bytes (hex):"/>
        <TextBox Grid.Row="2" x:Name="HexBox" Margin="0,24,0,4" Height="80"
                 FontFamily="Consolas" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <ListView Grid.Row="3" x:Name="EntriesList" Margin="0,8,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Section" Width="200" DisplayMemberBinding="{Binding Section}"/>
                    <GridViewColumn Header="Key" Width="280" DisplayMemberBinding="{Binding Key}"/>
                    <GridViewColumn Header="Value" Width="400" DisplayMemberBinding="{Binding Value}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Read-only by design. Writing is intentionally not exposed until the game's write policy is confirmed. -->
        <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="Gray"
                   Text="Read-only by design. Writing is not exposed until the game's write policy is confirmed."/>
    </Grid>
</UserControl>
