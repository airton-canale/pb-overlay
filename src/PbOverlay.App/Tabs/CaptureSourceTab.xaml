<UserControl x:Class="PbOverlay.App.Tabs.CaptureSourceTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RefreshButton" Content="Refresh" Padding="8,4" Click="RefreshButton_Click"/>
            <Button x:Name="StartCaptureButton" Grid.Column="1" Content="Start Capture" Padding="8,4" Margin="8,0,0,0" Click="StartCaptureButton_Click"/>
            <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <ListView x:Name="WindowsList" Grid.Row="1" Margin="0,8,0,8">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Title" Width="600" DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="Process" Width="180" DisplayMemberBinding="{Binding ProcessName}"/>
                    <GridViewColumn Header="PID" Width="80" DisplayMemberBinding="{Binding ProcessId}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Title contains:" VerticalAlignment="Center"/>
            <TextBox x:Name="TitleSubstringBox" Grid.Column="1" Margin="6,0,12,0" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Process name:" VerticalAlignment="Center"/>
            <TextBox x:Name="ProcessNameBox" Grid.Column="3" Margin="6,0,12,0" VerticalContentAlignment="Center"/>
            <Button Grid.Column="4" Content="Use selected" Padding="8,4" Click="UseSelectedButton_Click"/>
        </Grid>
    </Grid>
</UserControl>
