<UserControl x:Class="PbOverlay.App.Tabs.RoiCalibrationTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" LastChildFill="True" Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="AddProfileButton" Content="Add" Padding="6,2" Click="AddProfileButton_Click"/>
                <Button x:Name="RemoveProfileButton" Content="Remove" Padding="6,2" Margin="6,0,0,0" Click="RemoveProfileButton_Click"/>
                <Button x:Name="RenameProfileButton" Content="Rename" Padding="6,2" Margin="6,0,0,0" Click="RenameProfileButton_Click"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="Slots per team:"/>
                <Slider x:Name="SlotsSlider" Minimum="1" Maximum="16" Value="8"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="SlotsSlider_ValueChanged"/>
                <TextBlock x:Name="SlotsValueText" Text="8"/>
                <Button x:Name="SaveRoiButton" Content="Save rects to profile" Margin="0,8,0,0" Padding="6,4" Click="SaveRoiButton_Click"/>
                <Button x:Name="FreezeFrameButton" Content="Freeze Frame" Margin="0,4,0,0" Padding="6,4" Click="FreezeFrameButton_Click"/>
            </StackPanel>
            <ListBox x:Name="ProfilesList" DisplayMemberPath="Name" SelectionChanged="ProfilesList_SelectionChanged"/>
        </DockPanel>

        <Grid Grid.Column="1">
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
            <Canvas x:Name="RoiCanvas" Background="Transparent"/>
        </Grid>
    </Grid>
</UserControl>
